token="discord developer portal > Bot > Token"              # bot token
clientID="discord > right click bot > Copy User ID"         # bot client ID
threshold=3                                                 # minimum reaction count before posting or making a new board channel
boardCategoryID="right click category > copy category ID"   # category ID of where to place the board channels, because this WILL spam channels
closedBoards=true                                           # boards will have message permissions disabled for everyone unless they can bypass it